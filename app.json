{
  "expo": {
    "name": "Fintraq",
    "slug": "luno",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luno",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.nafish.luno",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon/foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#F1F1F1"
      },
      "predictiveBackGestureEnabled": false,
      "package": "me.nafish.luno",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 134,
          "resizeMode": "contain",
          "backgroundColor": "#11B67A"
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      "expo-iap",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0B7A53",
          "sounds": ["./assets/sounds/fintraq_reminder.wav"]
        }
      ],
      "expo-background-task",
      "react-native-notify-kit",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_expense": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-expense.png",
              "backgroundColor": "#6CF579"
            },
            "shortcut_income": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-income.png",
              "backgroundColor": "#6CF579"
            },
            "shortcut_transfer": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-transfer.png",
              "backgroundColor": "#6CF579"
            },
            "shortcut_loan": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-loan.png",
              "backgroundColor": "#6CF579"
            }
          }
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      "./plugins/with-fingerprint-not-required",
      "./plugins/with-text-measured-as-drawn"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7e2214b-0152-4a29-be8b-06ead99609b4"
      }
    },
    "owner": "idexa"
  }
}