{
  "expo": {
    "name": "Fintraq",
    "slug": "luno",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luno",
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#146B4A",
      "iosDisplayInForeground": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "me.nafish.luno",
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon/foreground.png",
        "backgroundImage": "./assets/images/adaptive-icon/background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#111412"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "me.nafish.luno",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F0",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#111412"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-localization",
      "expo-iap",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#146B4A",
          "sounds": ["./assets/sounds/fintraq_reminder.wav"]
        }
      ],
      "expo-background-task",
      "react-native-notify-kit",
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_expense": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-expense.png",
              "backgroundColor": "#151917"
            },
            "shortcut_income": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-income.png",
              "backgroundColor": "#151917"
            },
            "shortcut_transfer": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-transfer.png",
              "backgroundColor": "#151917"
            },
            "shortcut_loan": {
              "foregroundImage": "./assets/images/shortcuts/shortcut-loan.png",
              "backgroundColor": "#151917"
            }
          }
        }
      ],
      "expo-system-ui",
      "expo-secure-store",
      "./plugins/with-fingerprint-not-required"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7e2214b-0152-4a29-be8b-06ead99609b4"
      }
    },
    "owner": "idexa"
  }
}